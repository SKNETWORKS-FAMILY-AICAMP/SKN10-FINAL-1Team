option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: config.wsgi:application
  aws:elasticbeanstalk:application:environment:
    # --- Django & Database ---
    DJANGO_SETTINGS_MODULE: "config.settings"
    SECRET_KEY: "{{resolve:ssm-secure:SECRET_KEY:1}}"
    DEBUG: "False"
    DB_HOST: "{{resolve:ssm:DB_HOST:1}}"
    DB_NAME: "{{resolve:ssm:DB_NAME:1}}"
    DB_USER: "{{resolve:ssm:DB_USER:1}}"
    DB_PASSWORD: "{{resolve:ssm-secure:DB_PASSWORD:1}}"
    DB_PORT: "{{resolve:ssm:DB_PORT:1}}"

    # --- Service URLs & Secrets ---
    FASTAPI_INTERNAL_SECRET: "{{resolve:ssm-secure:FASTAPI_INTERNAL_SECRET:1}}"
    FASTAPI_SERVER_URL: "{{resolve:ssm:FASTAPI_SERVER_URL:1}}"
    LANGGRAPH_INVOKE_URL: "{{resolve:ssm:LANGGRAPH_INVOKE_URL:1}}"
    NEXTJS_SERVER_URL: "{{resolve:ssm:NEXTJS_SERVER_URL:1}}"

    # --- API Keys & External Services ---
    OPENAI_API_KEY: "{{resolve:ssm-secure:OPENAI_API_KEY:1}}"
    PINECONE_API_KEY: "{{resolve:ssm-secure:PINECONE_API_KEY:1}}"
    PINECONE_ENVIRONMENT: "{{resolve:ssm:PINECONE_ENVIRONMENT:1}}"
    S3_BUCKET_NAME: "{{resolve:ssm:S3_BUCKET_NAME:1}}"

container_commands:
  01_migrate:
    command: "python manage.py migrate"
    leader_only: true
  02_collectstatic:
    command: "python manage.py collectstatic --noinput"
  03_createsu:
    command: "python manage.py createsuperuser --noinput --username admin --email admin@example.com"
    leader_only: true
    ignoreErrors: true 